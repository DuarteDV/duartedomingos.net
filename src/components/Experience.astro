---
import Section from "./Section.astro";

interface Props {
  title: string;
  items: { company: string; role: string; period: string; bullets: string[]; stack: string[] }[];
}

const { title, items } = Astro.props;
---

<Section id="experience" title={title}>
  <ol class="space-y-12">
    {items.map((job) => (
      <li>
        <p class="font-mono text-xs text-muted">{job.period}</p>
        <h3 class="mt-1 text-lg font-medium">{job.role}</h3>
        <p class="text-muted">{job.company}</p>
        <ul class="mt-4 list-disc space-y-1.5 pl-5 marker:text-line">
          {job.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
        <p class="mt-4 font-mono text-xs text-accent">{job.stack.join(" · ")}</p>
      </li>
    ))}
  </ol>
</Section>
