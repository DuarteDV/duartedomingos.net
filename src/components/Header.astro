---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { t, type Locale, type Localized, type UiKey } from "../i18n/utils";

interface Props {
  locale: Locale;
  alternates: Localized<string>;
  homeHref: string;
}

const { locale, alternates, homeHref } = Astro.props;

const sections: [id: string, key: UiKey][] = [
  ["about", "nav.about"],
  ["experience", "nav.experience"],
  ["projects", "nav.projects"],
  ["skills", "nav.skills"],
  ["education", "nav.education"],
  ["contact", "nav.contact"],
];
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
  <div class="relative mx-auto flex h-16 max-w-5xl items-center gap-2 px-4 sm:px-6">
    <a href={homeHref} class="mr-auto font-mono text-sm font-medium tracking-tight">
      DD
    </a>

    <button
      type="button"
      data-menu-button
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label={t(locale, "menu.open")}
      data-label-open={t(locale, "menu.open")}
      data-label-close={t(locale, "menu.close")}
      class="inline-flex size-10 items-center justify-center rounded-lg text-muted hover:text-ink md:hidden order-last"
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav aria-label={t(locale, "nav.label")}>
      <ul
        id="site-menu"
        data-menu
        class="hidden border-line text-sm text-muted max-md:absolute max-md:inset-x-0 max-md:top-16 max-md:flex-col max-md:gap-1 max-md:border-b max-md:bg-surface max-md:px-4 max-md:pb-4 md:flex md:items-center md:gap-6"
      >
        {sections.map(([id, key]) => (
          <li>
            <a href={`${homeHref}#${id}`} class="block py-2 transition-colors hover:text-ink">
              {t(locale, key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1 md:ml-4">
      <LanguageSwitcher locale={locale} alternates={alternates} />
      <ThemeToggle label={t(locale, "theme.toggle")} />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-menu-button]");
    const menu = document.querySelector("[data-menu]");
    if (!button || !menu) return;

    const setOpen = (open) => {
      menu.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        open ? button.dataset.labelClose : button.dataset.labelOpen,
      );
    };

    button.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true"),
    );
    menu.addEventListener("click", (event) => {
      if (event.target.closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      const open = button.getAttribute("aria-expanded") === "true";
      if (open && !menu.contains(event.target) && !button.contains(event.target)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        button.focus();
      }
    });
  })();
</script>
