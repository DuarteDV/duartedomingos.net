---
import Section from "./Section.astro";

interface Props {
  title: string;
  groups: { name: string; items: string[] }[];
  languagesTitle: string;
  languages: { name: string; level: string }[];
}

const { title, groups, languagesTitle, languages } = Astro.props;
---

<Section id="skills" title={title}>
  <dl class="grid gap-8 sm:grid-cols-2">
    {groups.map((group) => (
      <div>
        <dt class="font-medium">{group.name}</dt>
        <dd class="mt-2 text-muted">{group.items.join(" · ")}</dd>
      </div>
    ))}
  </dl>
  <h3 class="mt-12 font-medium">{languagesTitle}</h3>
  <ul class="mt-3 flex flex-wrap gap-2">
    {languages.map((language) => (
      <li class="rounded-full border border-line px-3 py-1 text-sm">
        {language.name} <span class="text-muted">· {language.level}</span>
      </li>
    ))}
  </ul>
</Section>
