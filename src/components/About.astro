---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Section from "./Section.astro";

interface Props {
  title: string;
  about: string;
  availability: string;
  photo: ImageMetadata;
  name: string;
}

const { title, about, availability, photo, name } = Astro.props;
---

<Section id="about" title={title}>
  <div class="flex flex-col gap-8 sm:flex-row-reverse sm:items-start sm:justify-between">
    <Image
      src={photo}
      alt={name}
      widths={[160, 320]}
      sizes="160px"
      class="size-32 shrink-0 rounded-full border border-line object-cover sm:size-40"
    />
    <div class="max-w-2xl">
      <p>{about}</p>
      <p class="mt-6 flex items-start gap-3 text-muted">
        <span class="mt-2.5 size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        <span>{availability}</span>
      </p>
    </div>
  </div>
</Section>
