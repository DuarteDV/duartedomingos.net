---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  summary: string;
  year: number;
  stack: string[];
  cover: ImageMetadata;
}

const { href, title, summary, year, stack, cover } = Astro.props;
---

<article class="group relative">
  <div class="overflow-hidden rounded-xl border border-line bg-line/40">
    <Image
      src={cover}
      alt=""
      widths={[400, 800]}
      sizes="(min-width: 768px) 360px, 100vw"
      class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
    />
  </div>
  <p class="mt-4 font-mono text-xs text-muted">{year}</p>
  <h3 class="mt-1 text-lg font-medium">
    <a href={href} class="after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="mt-1 text-muted">{summary}</p>
  <p class="mt-3 font-mono text-xs text-accent">{stack.join(" · ")}</p>
</article>
