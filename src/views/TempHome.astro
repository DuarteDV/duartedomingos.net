---
import BaseLayout from "../layouts/BaseLayout.astro";
import { alternates, t, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title="Duarte Domingos"
  description="Duarte Domingos"
  alternates={alternates({ kind: "home" })}
>
  <h1>{t(locale, "nav.about")}</h1>
</BaseLayout>
