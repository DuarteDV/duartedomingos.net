---
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import { alternates, pathFor, t, type Locale } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ProjectEntry } from "../lib/projects";

interface Props {
  locale: Locale;
  slug: string;
  entry: ProjectEntry;
}

const { locale, slug, entry } = Astro.props;
const { title, summary, year, stack, cover, links } = entry.data;
const { Content } = await render(entry);
const ogImage = await getImage({ src: cover, width: 1200, format: "png" });
const backHref = `${pathFor(locale, { kind: "home" })}#projects`;
---

<BaseLayout
  locale={locale}
  title={`${title} · Duarte Domingos`}
  description={summary}
  alternates={alternates({ kind: "project", slug })}
  ogImage={ogImage.src}
>
  <article class="mx-auto max-w-3xl px-4 pt-16 pb-20 sm:px-6 md:pt-24">
    <a href={backHref} class="text-sm text-muted hover:text-ink">
      ← {t(locale, "projects.back")}
    </a>
    <p class="mt-10 font-mono text-sm text-accent">
      {year} · {stack.join(" · ")}
    </p>
    <h1 class="mt-3 text-4xl leading-tight font-medium tracking-[-0.02em] md:text-5xl">{title}</h1>
    <p class="mt-4 text-lg text-muted">{summary}</p>

    {links && (links.demo || links.code) && (
      <div class="mt-6 flex flex-wrap gap-3">
        {links.demo && (
          <a
            href={links.demo}
            class="rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-surface hover:opacity-85"
          >
            {t(locale, "projects.demo")}
          </a>
        )}
        {links.code && (
          <a
            href={links.code}
            class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium hover:border-ink"
          >
            {t(locale, "projects.code")}
          </a>
        )}
      </div>
    )}

    <Image
      src={cover}
      alt=""
      widths={[720, 1440]}
      sizes="(min-width: 768px) 720px, 100vw"
      loading="eager"
      class="mt-10 w-full rounded-xl border border-line"
    />

    <div class="prose-content mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
