---
// Printable CV (A4) rebuilt from the original Canva template. It is the source of the PDFs in
// public/cv/, generated by `npm run cv`; it isn't linked anywhere and stays out of the sitemap.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import photo from "../../assets/duarte-domingos.jpg";
import { jobs, profile, skills, spokenLanguages, studies } from "../../data/cv";
import { locales, pick, t, type Locale } from "../../i18n/utils";
import { formatPeriod } from "../../lib/dates";
import { getProjects } from "../../lib/projects";

export const getStaticPaths = (() =>
  locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const [firstName, ...lastNames] = profile.name.split(" ");
const role = pick(profile.eyebrow, locale).split(" · ")[0];
const projects = (await getProjects()).slice(0, 2).map(({ byLocale }) => byLocale[locale].data);
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} · CV</title>
  </head>
  <body>
    <div class="page">
      <aside>
        <Image src={photo} alt={profile.name} width={320} loading="eager" class="photo" />

        <section>
          <h2>{t(locale, "nav.contact")}</h2>
          <dl>
            <dt>{t(locale, "cv.email")}</dt>
            <dd>{profile.email}</dd>
            <dt>{t(locale, "cv.website")}</dt>
            <dd>duartedomingos.net</dd>
            <dt>LinkedIn</dt>
            <dd>{bare(profile.links.linkedin)}</dd>
            <dt>GitHub</dt>
            <dd>{bare(profile.links.github)}</dd>
          </dl>
        </section>

        <section>
          <h2>{t(locale, "nav.education")}</h2>
          {studies.map((study) => (
            <div class="study">
              <h3>{study.center}</h3>
              <p>
                {pick(study.title, locale)} | {study.start} – {study.end}
              </p>
            </div>
          ))}
        </section>

        <section>
          <h2>{t(locale, "section.languages")}</h2>
          <ul>
            {spokenLanguages.map((language) => (
              <li>
                {pick(language.name, locale)} – {pick(language.level, locale)}
              </li>
            ))}
          </ul>
        </section>
      </aside>

      <main>
        <header>
          <h1>
            <span>{firstName}</span> <span>{lastNames.join(" ")}</span>
          </h1>
          <p>{role}</p>
        </header>

        <div class="content">
          <section>
            <h2>{t(locale, "cv.profile")}</h2>
            <p>{pick(profile.about, locale)}</p>
            <p class="availability">{pick(profile.availability, locale)}</p>
          </section>

          <section>
            <h2>{t(locale, "cv.experience")}</h2>
            {jobs.map((job) => (
              <div class="job">
                <h3>{pick(job.role, locale)}</h3>
                <p class="meta">
                  {job.company} | {formatPeriod(job.start, job.end, locale)}
                </p>
                <ul>
                  {pick(job.bullets, locale).map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </section>

          <section>
            <h2>{t(locale, "nav.projects")}</h2>
            {projects.map((project) => (
              <div class="project">
                <h3>
                  {project.title} · {project.year}
                </h3>
                <p>{project.summary}</p>
              </div>
            ))}
          </section>

          <section>
            <h2>{t(locale, "nav.skills")}</h2>
            <ul class="skills">
              {skills.map((group) => (
                <li>
                  <strong>{pick(group.name, locale)}:</strong> {group.items.join(" · ")}
                </li>
              ))}
            </ul>
          </section>
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  html,
  body {
    margin: 0;
  }

  body {
    font-family: "Lato", sans-serif;
    font-size: 8.8pt;
    line-height: 1.38;
    color: #2b2b2b;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  @media screen {
    body {
      background: #9a9a9a;
      padding: 24px 0;
    }
  }

  .page {
    display: grid;
    grid-template-columns: 70mm 1fr;
    width: 210mm;
    height: 297mm;
    margin: 0 auto;
    overflow: hidden;
    background: #fff;
  }

  aside {
    background: #e7e7e7;
    padding: 11mm 7mm 9mm 9mm;
  }

  .photo {
    display: block;
    width: 42mm;
    height: 42mm;
    margin: 0 auto 8mm;
    border-radius: 50%;
    object-fit: cover;
  }

  h2 {
    margin: 0 0 2.5mm;
    padding-bottom: 1.8mm;
    border-bottom: 1px solid #8f8f8f;
    font-size: 10pt;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #333;
  }

  aside section + section {
    margin-top: 7mm;
  }

  dt,
  aside h3 {
    margin: 2.4mm 0 0.4mm;
    font-size: 7.6pt;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  aside p {
    margin: 0;
  }

  ul {
    margin: 0;
    padding-left: 4.2mm;
  }

  li {
    margin: 0.5mm 0;
  }

  main header {
    padding: 9mm 8mm 7mm;
    background: #1f3a2e;
    color: #fff;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 27pt;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
  }

  h1 span {
    display: block;
  }

  header p {
    margin: 2.5mm 0 0;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .content {
    padding: 7mm 9mm 7mm 8mm;
  }

  .content section + section {
    margin-top: 4.5mm;
  }

  .content p {
    margin: 0;
  }

  .availability {
    margin-top: 1.5mm !important;
    font-weight: 700;
    color: #1f3a2e;
  }

  .job + .job,
  .project + .project {
    margin-top: 2.6mm;
  }

  main h3 {
    margin: 0;
    font-size: 8.8pt;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .meta {
    margin-bottom: 0.8mm !important;
    color: #555;
  }

  .skills {
    padding-left: 0;
    list-style: none;
  }
</style>
