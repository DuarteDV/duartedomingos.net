---
import { alternates, locales, pathFor, t } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="es"
  title={`404 · ${t("es", "notFound.title")}`}
  description={t("es", "notFound.body")}
  alternates={alternates({ kind: "home" })}
  noindex
>
  <div class="mx-auto max-w-5xl px-4 pt-24 pb-32 sm:px-6 md:pt-32">
    {locales.map((locale) => (
      <section data-404-lang={locale} lang={locale} hidden={locale !== "es"}>
        <p class="font-mono text-sm text-accent">404</p>
        <h1 class="mt-4 text-4xl font-medium tracking-[-0.02em] md:text-5xl">
          {t(locale, "notFound.title")}
        </h1>
        <p class="mt-4 text-lg text-muted">{t(locale, "notFound.body")}</p>
        <a
          href={pathFor(locale, { kind: "home" })}
          class="mt-8 inline-block rounded-lg bg-ink px-5 py-2.5 text-sm font-medium text-surface hover:opacity-85"
        >
          {t(locale, "notFound.home")}
        </a>
      </section>
    ))}
  </div>
</BaseLayout>

<!-- Firebase serves this single page for every missing URL: show the block for the URL's locale.
     Mirrors getLocaleFromPath() in src/i18n/utils.ts. -->
<script is:inline>
  (() => {
    const first = location.pathname.split("/").filter(Boolean)[0];
    const locale = first === "en" || first === "ca" ? first : "es";
    if (locale === "es") return;
    document.querySelectorAll("[data-404-lang]").forEach((block) => {
      block.hidden = block.getAttribute("data-404-lang") !== locale;
    });
    document.documentElement.lang = locale;
  })();
</script>
